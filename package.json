    "oh-vue-icons": "^1.0.0-rc3",
    "pinia": "^3.0.4",
    "unplugin-vue-components": "^32.0.0",
    "uuid": "^14.0.0",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.20",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.1",
    "typescript": "~6.0.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
