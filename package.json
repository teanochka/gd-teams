{
  "name": "gd-teams",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:network": "vite --host 0.0.0.0",
    "api": "json-server db.json --port 3000",
    "dev:all": "run-p api dev",
    "build": "run-p type-check \"build-only {@}\" --",
